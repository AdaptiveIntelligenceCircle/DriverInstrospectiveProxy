{
  "policy_name": "default_policy",
  "version": "1.0.0",
  "defaults": {
    "forbidden_permissions": [
      "raw_kernel_write",
      "override_safety_mode",
      "direct_memory_map",
      "unauthorized_stream_publish"
    ],
    "safe_threshold": 0.65
  },
  "rules": [
    {
      "trigger": "plugin_load",
      "action": {
        "deny_if_forbidden_permission": true
      }
    },
    {
      "trigger": "model_load",
      "action": {
        "verify_checksum": true,
        "verify_metadata_schema": true
      }
    },
    {
      "trigger": "transport_packet",
      "action": {
        "deny_if_unknown_source": true
      }
    }
  ]
}
