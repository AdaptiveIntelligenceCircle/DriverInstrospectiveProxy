{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "AICP AI Model Metadata",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "model_type": { "type": "string" },
    "checksum": { "type": "string" },
    "weights_path": { "type": "string" },
    "input_dim": { "type": "integer" },
    "output_dim": { "type": "integer" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_inference_ms": { "type": "number" },
        "max_memory_mb": { "type": "number" }
      }
    }
  },
  "required": ["name", "version", "model_type", "checksum"]
}
